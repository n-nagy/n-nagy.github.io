<script>
function toggleDrawer(id, rowEl) {
  var drawer = document.getElementById(id);
  var isOpen = drawer.classList.contains('open');
  var toggle = rowEl.querySelector('.bar-toggle');

  // Close all drawers
  document.querySelectorAll('.quote-drawer').forEach(function(d) { d.classList.remove('open'); });
  document.querySelectorAll('.bar-row').forEach(function(r) { r.classList.remove('active'); });
  document.querySelectorAll('.bar-toggle').forEach(function(t) { t.textContent = '▸ quotes'; });

  // Open this one if it was closed
  if (!isOpen) {
    drawer.classList.add('open');
    rowEl.classList.add('active');
    toggle.textContent = '▾ quotes';
  }
}
</script>
